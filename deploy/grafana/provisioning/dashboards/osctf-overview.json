{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "OSCTF Overview",
  "tags": ["osctf"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP request rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(osctf_http_requests_total[1m])) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p99 latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(osctf_http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Submissions",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(osctf_submissions_total[1m])) by (correct)", "legendFormat": "correct={{correct}}" }
      ]
    },
    {
      "type": "stat",
      "title": "WebSocket connections",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [{ "expr": "osctf_ws_connections" }]
    },
    {
      "type": "timeseries",
      "title": "Instances by state",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "expr": "osctf_instances", "legendFormat": "{{state}}" }
      ]
    }
  ]
}
