    {
      "id": "t_1942",
      "type": "text",
      "x": 90,
      "y": 210.0,
      "width": 360,
      "height": 90.0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "text": "(0)  boot orphan sweep\n\nread RuntimeDir pidfiles\n{pid, token, owner}\nkill ONLY if: alive AND token\nmatches argv AND owner is dead",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r_1940",
      "originalText": "(0)  boot orphan sweep\n\nread RuntimeDir pidfiles\n{pid, token, owner}\nkill ONLY if: alive AND token\nmatches argv AND owner is dead",
      "autoResize": false,
      "lineHeight": 1.25,
      "angle": 0,
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
