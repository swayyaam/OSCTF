    {
      "id": "t_1724",
      "type": "text",
      "x": 1510,
      "y": 610.0,
      "width": 780,
      "height": 130.0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "text": "compute()  \u2014  the durability claim\n\nbuilt-in mode  ->  scoring.Value(formula, solveCount)   retroactive, decays\nplugin mode    ->  THIS solve's recorded scored_value      locked at solve time\nNULL record    ->  deterministic default 0\n\nthe read path NEVER calls a plugin \u2014 so the served board equals a\nfrom-scratch recompute over (log + records) even with every plugin down",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r_1722",
      "originalText": "compute()  \u2014  the durability claim\n\nbuilt-in mode  ->  scoring.Value(formula, solveCount)   retroactive, decays\nplugin mode    ->  THIS solve's recorded scored_value      locked at solve time\nNULL record    ->  deterministic default 0\n\nthe read path NEVER calls a plugin \u2014 so the served board equals a\nfrom-scratch recompute over (log + records) even with every plugin down",
      "autoResize": false,
      "lineHeight": 1.25,
      "angle": 0,
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 1725,
      "version": 1,
      "versionNonce": 1725,
      "isDeleted": false,
      "updated": 1,
      "link": null,
      "locked": false
