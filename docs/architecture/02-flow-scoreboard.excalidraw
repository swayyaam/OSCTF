    },
    {
      "id": "t_1756",
      "type": "text",
      "x": 1510,
      "y": 1105.0,
      "width": 780,
      "height": 30.0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "text": "repair is deliberately NOT inline on read: that is what makes a recompute deterministic \u2014\nthe same missing record resolves identically whether or not the plugin is reachable",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r_1754",
      "originalText": "repair is deliberately NOT inline on read: that is what makes a recompute deterministic \u2014\nthe same missing record resolves identically whether or not the plugin is reachable",
      "autoResize": false,
      "lineHeight": 1.25,
      "angle": 0,
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 1757,
      "version": 1,
      "versionNonce": 1757,
      "isDeleted": false,
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "r_1758",
      "type": "rectangle",
      "x": 80,
      "y": 900,
      "width": 960,
      "height": 330,
      "strokeColor": "#f08c00",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "roundness": {
        "type": 3
      },
      "boundElements": [
        {
          "type": "text",
