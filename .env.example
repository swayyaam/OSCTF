# OSCTF configuration — copy to .env and edit. Complete reference: docs/v0.1/10-deployment.md
# Every variable the platform reads is listed here with its default.

# --- Public origin ------------------------------------------------------------
# Drives the cookie Secure flag, the CSRF Origin check, and {host} in connection templates.
OSCTF_BASE_URL=http://localhost:8080
# Override the host shown in challenge connection info (default: host of OSCTF_BASE_URL).
OSCTF_PUBLIC_HOST=
OSCTF_HTTP_ADDR=:8080

# --- Datastores ---------------------------------------------------------------
OSCTF_DATABASE_URL=postgres://osctf:osctf@postgres:5432/osctf?sslmode=disable
OSCTF_REDIS_URL=redis://redis:6379/0
OSCTF_S3_ENDPOINT=minio:9000
OSCTF_S3_ACCESS_KEY=osctf-minio
OSCTF_S3_SECRET_KEY=osctf-minio-secret
OSCTF_S3_BUCKET=osctf
OSCTF_S3_USE_SSL=false

# --- First-boot admin (required on first boot) --------------------------------
# CHANGE THESE. The platform logs a loud warning if the password is left as-is.
OSCTF_ADMIN_EMAIL=admin@example.com
OSCTF_ADMIN_PASSWORD=change-me-now

# --- Behaviour ----------------------------------------------------------------
OSCTF_SESSION_TTL=168h
OSCTF_REGISTRATION_OPEN=true
OSCTF_TEAM_MAX_SIZE=4
OSCTF_MAX_ATTACHMENT_MB=100
# Host port range for challenge containers. Widened in v0.2 for per-team instancing
# (many teams x quota). Keep firewall/compose in sync and >= expected concurrent instances.
OSCTF_PORT_RANGE_START=30000
OSCTF_PORT_RANGE_END=32767
OSCTF_DOCKER_HOST=
OSCTF_SEED_EXAMPLES=true
OSCTF_TRUST_PROXY=false

# --- Instances (v0.2) ---------------------------------------------------------
# Per-team challenge instances: default time-to-live, extend step, and max lifetime.
OSCTF_INSTANCE_TTL=3600s
OSCTF_INSTANCE_EXTEND=1800s
OSCTF_INSTANCE_MAX_TTL=14400s
# Max concurrent running instances one team may hold across all challenges.
OSCTF_TEAM_INSTANCE_QUOTA=3
# Prefix for generated per-instance flags: osctf{...}. Match your event brand if desired.
OSCTF_FLAG_PREFIX=osctf

# --- Dev only -----------------------------------------------------------------
# Allow the Vite origin during local development (empty = disabled in prod).
OSCTF_CORS_DEV_ORIGIN=

# --- Logging ------------------------------------------------------------------
OSCTF_LOG_FORMAT=json
OSCTF_LOG_LEVEL=info

# --- Compose plumbing (used by docker-compose.yml, not read by the app) -------
# The Docker group id to grant the platform container so it can reach the socket.
# On Linux: `getent group docker | cut -d: -f3`. On Docker Desktop, 0 is fine.
OSCTF_DOCKER_GID=0
# Credentials handed to the bundled MinIO service (must match OSCTF_S3_* above).
MINIO_ROOT_USER=osctf-minio
MINIO_ROOT_PASSWORD=osctf-minio-secret
# Postgres bootstrap (must match OSCTF_DATABASE_URL above).
POSTGRES_USER=osctf
POSTGRES_PASSWORD=osctf
POSTGRES_DB=osctf
