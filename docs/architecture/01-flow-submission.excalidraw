      "boundElements": [],
      "text": "(1)  handlers.SubmitFlag\nPOST /api/v1/challenges/{slug}/submit\n\nrequireUser \u00b7 Users.TeamOf -> team?\nrate limit 10/min (team+challenge)\nrate limit 30/min (user)\nteam banned? \u00b7 caller admin?",
      "fontSize": 11,
      "fontFamily": 2,
