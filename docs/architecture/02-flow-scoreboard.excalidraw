      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "text": "WS hub per client\n\nONE ordered queue\nsnapshots coalesce with\nthe TAIL only\nphase frames never dropped\nbacklog > 64 -> disconnect\n(reconnect is forgiven)",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r_1770",
      "originalText": "WS hub per client\n\nONE ordered queue\nsnapshots coalesce with\nthe TAIL only\nphase frames never dropped\nbacklog > 64 -> disconnect\n(reconnect is forgiven)",
