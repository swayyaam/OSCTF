      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "text": "fd budget accountant   (internal/fdbudget)\n\nRLIMIT_NOFILE (soft)\n\n  reserve = soft/4 (min 256)\n     -> DB \u00b7 Docker \u00b7 Redis \u00b7 S3 \u00b7 HTTP\n\n  claim 1: plugin-inflight\n     essential, fixed \u2014 guaranteed its share\n\n  claim 2: websocket-conns\n     elastic \u2014 CLAMPED to the remainder\n\nONE accountant: the reserve is counted\nONCE, not once per consumer",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r_1336",
      "originalText": "fd budget accountant   (internal/fdbudget)\n\nRLIMIT_NOFILE (soft)\n\n  reserve = soft/4 (min 256)\n     -> DB \u00b7 Docker \u00b7 Redis \u00b7 S3 \u00b7 HTTP\n\n  claim 1: plugin-inflight\n     essential, fixed \u2014 guaranteed its share\n\n  claim 2: websocket-conns\n     elastic \u2014 CLAMPED to the remainder\n\nONE accountant: the reserve is counted\nONCE, not once per consumer",
      "autoResize": false,
      "lineHeight": 1.25,
      "angle": 0,
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
