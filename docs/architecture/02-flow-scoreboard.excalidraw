    {
      "id": "t_1748",
      "type": "text",
      "x": 1510,
      "y": 907.5,
      "width": 780,
      "height": 105.0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "text": "score repair worker  \u2014  OFF the read path  (10s tick, batch 200)\n\nrefresh gauges: osctf_plugin_scores_missing / _pending\nListSolvesNeedingScore -> Score -> RecordScore\n\nMISSING (scored_by NULL, write never landed)  =  ALERTABLE absence\nPENDING (scored_by 'pending', plugin was down) =  expected, clears on recovery",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r_1746",
      "originalText": "score repair worker  \u2014  OFF the read path  (10s tick, batch 200)\n\nrefresh gauges: osctf_plugin_scores_missing / _pending\nListSolvesNeedingScore -> Score -> RecordScore\n\nMISSING (scored_by NULL, write never landed)  =  ALERTABLE absence\nPENDING (scored_by 'pending', plugin was down) =  expected, clears on recovery",
      "autoResize": false,
      "lineHeight": 1.25,
      "angle": 0,
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 1749,
      "version": 1,
      "versionNonce": 1749,
      "isDeleted": false,
      "updated": 1,
      "link": null,
      "locked": false
    },
