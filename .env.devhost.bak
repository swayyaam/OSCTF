# Local dev env (gitignored). API runs on the host against the compose dev ports.
OSCTF_BASE_URL=http://localhost:8080
OSCTF_HTTP_ADDR=:8080
OSCTF_DATABASE_URL=postgres://osctf:osctf@localhost:5432/osctf?sslmode=disable
OSCTF_REDIS_URL=redis://localhost:6379/0
OSCTF_S3_ENDPOINT=localhost:9000
OSCTF_S3_ACCESS_KEY=osctf-minio
OSCTF_S3_SECRET_KEY=osctf-minio-secret
OSCTF_S3_BUCKET=osctf
OSCTF_S3_USE_SSL=false
OSCTF_ADMIN_EMAIL=admin@example.com
OSCTF_ADMIN_PASSWORD=devpassword123
OSCTF_SEED_EXAMPLES=true
OSCTF_LOG_FORMAT=text
OSCTF_LOG_LEVEL=info
