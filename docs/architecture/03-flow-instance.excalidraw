      "y": 1065.6,
      "width": 1780,
      "height": 48.8,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "text": "at boot: an initial Reconcile, plus an async VerifyIsolation self-check whose verdict ARMS THE ISOLATION GATE.\nIf per-team isolation is unenforced or could not be verified, container deploys are REFUSED (fail closed) until it\nresolves or OSCTF_ALLOW_UNISOLATED_INSTANCES is set \u2014 logged loudly at boot and on every unisolated deploy.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r_1900",
      "originalText": "at boot: an initial Reconcile, plus an async VerifyIsolation self-check whose verdict ARMS THE ISOLATION GATE.\nIf per-team isolation is unenforced or could not be verified, container deploys are REFUSED (fail closed) until it\nresolves or OSCTF_ALLOW_UNISOLATED_INSTANCES is set \u2014 logged loudly at boot and on every unisolated deploy.",
      "autoResize": false,
      "lineHeight": 1.25,
      "angle": 0,
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
