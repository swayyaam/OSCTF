      "fillStyle": "solid",
      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "text": "registry wiring at HEAD\n\nchallenge_type   WIRED  (#8)\nscoring          WIRED  (#9)\nnotification     WIRED  (#10)\n\nauth             -> M3\n  needs redirect/callback routes,\n  identity mapping + provisioning\n  policy \u2014 not just a registrar line",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r_2062",
      "originalText": "registry wiring at HEAD\n\nchallenge_type   WIRED  (#8)\nscoring          WIRED  (#9)\nnotification     WIRED  (#10)\n\nauth             -> M3\n  needs redirect/callback routes,\n  identity mapping + provisioning\n  policy \u2014 not just a registrar line",
      "autoResize": false,
      "lineHeight": 1.25,
      "angle": 0,
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
