    {
      "id": "t_1946",
      "type": "text",
      "x": 510,
      "y": 210.0,
      "width": 320,
      "height": 90.0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "text": "(1)  discovery\n\nscan PluginsDir one level, sorted\nplugin.yaml parsed STRICTLY\ninvalid -> that plugin fails ALONE\nname collision -> BOTH fail",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r_1944",
      "originalText": "(1)  discovery\n\nscan PluginsDir one level, sorted\nplugin.yaml parsed STRICTLY\ninvalid -> that plugin fails ALONE\nname collision -> BOTH fail",
      "autoResize": false,
      "lineHeight": 1.25,
      "angle": 0,
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
